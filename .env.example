# ---------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is never committed to git.
# ---------------------------------------------------------------

# MongoDB Atlas connection string.
# Get it from: Atlas dashboard -> Connect -> Drivers -> copy the string,
# then replace <password> with your database user's password.
# NEVER put a real password in this file — it is a template meant to be shared.
# Real values go in .env.local, which git ignores.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/printpress?retryWrites=true&w=majority"

# The shop's timezone. Every "today", "this week" and "this month" is worked
# out in this zone. Leave it as Africa/Lagos unless the shop is elsewhere —
# without it, a host running on UTC would shift every daily total by an hour.
APP_TIMEZONE="Africa/Lagos"

# Secret used to sign login sessions. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Credentials created by `npm run seed` for the first owner login.
SEED_OWNER_NAME="Shop Owner"
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="changeme123"

# --- Optional: daily takings summary by email -------------------
# Leave blank to disable email. The in-app summary and the
# "Send on WhatsApp" button work without any of this.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PrintPress POS <no-reply@example.com>"

# Shared secret for the daily-summary cron endpoint.
CRON_SECRET="another-long-random-string"
