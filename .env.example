# ---------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is never committed to git.
#
# On Vercel these are not read from a file at all — each one is entered
# under Settings -> Environment Variables. Same names, same values.
# ---------------------------------------------------------------

# MongoDB Atlas connection string.
# Atlas dashboard -> Connect -> Drivers -> copy the string, then replace
# <password> with the real database password.
#
# The database name is the word after the last slash. Keep the shop's live
# records and any test database apart by name: pointing a test run at the
# live one is how a shop loses its books, and the two strings are identical
# except for that single word.
#
#   live      .../framing?retryWrites=true&w=majority
#   testing   .../framing_dev?retryWrites=true&w=majority
#
# NEVER put a real password in this file — it is a template meant to be
# shared. Real values go in .env.local, which git ignores.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/framing?retryWrites=true&w=majority"

# The shop's timezone. Every "today", "this week" and "this month" is worked
# out in this zone. Leave it as Africa/Lagos unless the shop is elsewhere —
# without it, a host running on UTC would shift every daily total by an hour.
APP_TIMEZONE="Africa/Lagos"

# Secret used to sign login sessions. Any long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Use a DIFFERENT value on Vercel than on any development machine. Anyone
# holding this can mint a session and sign in as the owner.
AUTH_SECRET="change-me-to-a-long-random-string"

# The first account, created by `npm run seed` on an empty database.
# Change this password under Staff as soon as you have signed in — this file
# is in the repository, so everybody can read what it says.
SEED_OWNER_NAME="Shop Owner"
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="changeme123"

# --- Optional: daily takings summary by email -------------------
# Leave blank to switch email off. The in-app summary and the
# "Send on WhatsApp" button work without any of this.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Master's Technology <no-reply@example.com>"

# Shared secret for the nightly summary job. Vercel sends it in an
# Authorization header; without it the endpoint refuses to run, so a stranger
# cannot trigger the shop's daily report or read its takings.
CRON_SECRET="another-long-random-string"
